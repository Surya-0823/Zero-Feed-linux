{
  "manifest_version": 3,
  "name": "ZeroFeed Focus Guard",
  "version": "1.0.0",
  "description": "ZeroFeed Browser Extension - Eliminates distraction feeds under enterprise policy.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ZeroFeed Extension Status"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
